# =============================================================================
# ENTRETEMPS - Configuración de Variables de Entorno
# =============================================================================
# Copia este archivo a .env.local y rellena los valores correspondientes
# Las variables con NEXT_PUBLIC_ son accesibles en el cliente
# Las demás son server-only y no se exponen al navegador
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE (OBLIGATORIO)
# -----------------------------------------------------------------------------
# Obtén estos valores desde: https://supabase.com -> Tu Proyecto -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# URL pública del sitio (para OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Login con Google (opcional). Requiere cliente OAuth en Google Cloud
# y activar el proveedor en Supabase -> Authentication -> Providers
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN=false

# -----------------------------------------------------------------------------
# PROVEEDOR DE IA (OBLIGATORIO - Elige UNO)
# -----------------------------------------------------------------------------
# Opciones disponibles: 'gemini', 'n8n', 'openai' (mock)
AI_PROVIDER=gemini

# -----------------------------------------------------------------------------
# GOOGLE GEMINI (SI AI_PROVIDER=gemini)
# -----------------------------------------------------------------------------
# Obtén tu API key gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu-gemini-api-key-aqui
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TEMPERATURE=0.8
# Las misiones jugables necesitan margen: con menos tokens el JSON puede truncarse
GEMINI_MAX_TOKENS=8192

# -----------------------------------------------------------------------------
# CUOTA POR USUARIO (ventana de 24h)
# -----------------------------------------------------------------------------
# Protege la cuota gratuita de Gemini (que es por proyecto) frente a abusos.
# Requiere la tabla ai_generations: ejecuta supabase-ai-generations-setup.sql
DAILY_ADVENTURE_LIMIT=5
DAILY_MISSION_LIMIT=20

# -----------------------------------------------------------------------------
# N8N WEBHOOK (SI AI_PROVIDER=n8n)
# -----------------------------------------------------------------------------
# URL del webhook de n8n para generación de aventuras
N8N_WEBHOOK_URL=https://tu-instancia.n8n.cloud/webhook/entretemps/generate-pack

# -----------------------------------------------------------------------------
# OPENAI (SI AI_PROVIDER=openai) - ACTUALMENTE MOCK
# -----------------------------------------------------------------------------
# Nota: El adaptador OpenAI está preparado pero usa mock por defecto
# OPENAI_API_KEY=sk-tu-openai-key-aqui

# -----------------------------------------------------------------------------
# PORTADAS (OPCIONAL - DESACTIVADAS POR DEFECTO)
# -----------------------------------------------------------------------------
# Por coste y calidad, las aventuras se generan solo con texto y la UI usa
# ilustraciones propias. Pon ENABLE_COVER_IMAGES=true para volver a activarlas.
ENABLE_COVER_IMAGES=false

# Generador por IA: 'nanobanana' | 'pollinations' | vacío
# IMAGE_GENERATOR_PROVIDER=pollinations
# POLLINATIONS_API_KEY=tu-pollinations-key-aqui
# NANOBANANA_MODEL=gemini-2.5-flash-image

# Búsqueda de fotos en Pexels (alternativa si no hay generador o falla)
# PEXELS_API_KEY=tu-pexels-api-key-aqui

# -----------------------------------------------------------------------------
# VARIABLES LEGACY (DEPRECATED - NO USAR)
# -----------------------------------------------------------------------------
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_URL=
